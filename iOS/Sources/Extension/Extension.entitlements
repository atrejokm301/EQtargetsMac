<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- An array with exactly one element. A bare string stops the extension launching. -->
	<key>com.apple.developer.media-device-extension</key>
	<array>
		<string>media-device-protocol.com.eqtargets.ios</string>
	</array>
	<key>keychain-access-groups</key>
	<array>
		<string>$(AppIdentifierPrefix)com.eqtargets.ios.link</string>
	</array>
</dict>
</plist>
