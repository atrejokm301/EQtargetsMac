<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Holds what the tiles show: on or off and a Bass Style name. It is separate
	     from the audio link's group, so this extension can never read the link key. -->
	<key>keychain-access-groups</key>
	<array>
		<string>$(AppIdentifierPrefix)com.eqtargets.ios.controls</string>
	</array>
</dict>
</plist>
